# Copy to `.env` and fill in your values. Never commit `.env`.
#
# The API base URL the app talks to. Use your PC's LAN IP address —
# NOT localhost: the phone runs on the same Wi-Fi but localhost would
# point at the phone itself.
# Find it with:  ipconfig  (look for "IPv4 Address" on your Wi-Fi adapter)
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api
